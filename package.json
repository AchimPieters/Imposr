{
  "name": "imposr-pro",
  "version": "1.0.0",
  "description": "Professional PDF Imposition Software",
  "author": "Achim Pieters",
  "license": "Commercial",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "build": "npm run build:main",
    "build:main": "tsc --project tsconfig.json",
    "build:renderer": "node -e \"console.log('Renderer build is not configured in this repository')\"",
    "package": "electron-builder build --publish never",
    "package:all": "electron-builder build -mwl --publish never",
    "release": "electron-builder build --publish always",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/cli/index.js",
    "api": "node dist/api/server.js",
    "beta:ready": "npm run build:main && node dist/cli/beta-ready.js --release-root . --evidence docs/sdk_smoke_evidence.json --output docs/BETA_READINESS_REPORT.json"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.269",
    "canvas": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "@reduxjs/toolkit": "^2.0.1",
    "react-router-dom": "^6.21.1",
    "axios": "^1.6.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "stripe": "^14.10.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "chokidar": "^3.5.3",
    "glob": "^10.3.10",
    "uuid": "^9.0.1",
    "crypto-js": "^4.2.0",
    "node-machine-id": "^1.1.12",
    "@sentry/electron": "^4.17.0",
    "posthog-node": "^3.6.3",
    "dayjs": "^1.11.10",
    "zod": "^3.22.4",
    "immer": "^10.0.3",
    "module-alias": "^2.2.3"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "ts-loader": "^9.5.1",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.6.0",
    "copy-webpack-plugin": "^11.0.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@playwright/test": "^1.40.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.1"
  },
  "build": {
    "appId": "com.imposr.app",
    "productName": "Imposr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "templates/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Graphics"
    },
    "publish": {
      "provider": "github",
      "owner": "AchimPieters",
      "repo": "Imposr"
    }
  },
  "_moduleAliases": {
    "@core": "dist/core",
    "@renderer": "dist/renderer",
    "@utils": "dist/utils",
    "@licensing": "dist/licensing"
  }
}
